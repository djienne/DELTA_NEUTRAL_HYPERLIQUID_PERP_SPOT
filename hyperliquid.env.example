# Copy to hyperliquid.env (gitignored, dockerignored) and fill in.
exchange=hyperliquid

# Account the bot trades: your main wallet address, or the sub-account / vault address when is_vault=true
wallet_address=0xYourAccountAddress

# API wallet private key (Hyperliquid: More -> API). Not your wallet's own key: it can trade but not transfer.
private_key=0xYourApiWalletPrivateKey

# true for a sub-account or vault: every order and leverage change is signed with vaultAddress=wallet_address
is_vault=false
